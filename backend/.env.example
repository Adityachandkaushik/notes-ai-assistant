# ======================
# NoteAI Backend Config
# ======================

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/noteai

# JWT secret -- CHANGE THIS in production!
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# AI Provider: Groq (free) -- get key at https://console.groq.com/keys
AI_API_KEY=gsk_your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
# Available Groq models (2025): qwen/qwen3.8-27b, qwen/qwen3.6-27b, openai/gpt-oss-120b
AI_MODEL=qwen/qwen3.8-27b
AI_VISION_MODEL=openai/gpt-oss-120b

# Alternative: OpenAI
# AI_API_KEY=sk-proj-your_openai_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ─── AWS S3 Configuration ───────────────────────────────────────────────────
# 1. Create an S3 bucket at https://s3.console.aws.amazon.com/s3/
# 2. Disable "Block all public access" only if you need public file URLs
#    (for this app we delete files after parsing — so leave it blocked)
# 3. Create an IAM user or role with the policy below and generate access keys
#
# Minimal IAM policy (JSON):
# {
#   "Version": "2012-10-17",
#   "Statement": [{
#     "Effect": "Allow",
#     "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
#     "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/*"
#   }]
# }
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET=your-s3-bucket-name-here
